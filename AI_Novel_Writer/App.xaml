<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AINovelWriter.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AINovelWriter"
    xmlns:converters="using:AINovelWriter.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 值转换器 -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:BoolToInvertVisibilityConverter x:Key="BoolToInvertVisibility" />
            <converters:InvertBoolConverter x:Key="InvertBool" />
            <converters:StatusColorConverter x:Key="StatusColorConverter" />
            <converters:WordCountVisibilityConverter x:Key="WordCountVisibility" />
            <converters:ParticipationColorConverter x:Key="ParticipationColor" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
            <converters:CountToVisibilityConverter x:Key="CountToVisibility" />
            <converters:AiRatioColorConverter x:Key="AiRatioColor" />
            <converters:ConfirmTextConverter x:Key="ConfirmText" />
            <converters:ConfirmBrushConverter x:Key="ConfirmBrush" />

            <!-- 特性卡片样式 -->
            <Style x:Key="FeatureCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="18" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>

            <!-- 面板小标题 -->
            <Style x:Key="PanelHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="CharacterSpacing" Value="60" />
            </Style>

            <!-- 能力矩阵小胶囊 -->
            <Style x:Key="AbilityChip" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource LayerFillColorAltBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
