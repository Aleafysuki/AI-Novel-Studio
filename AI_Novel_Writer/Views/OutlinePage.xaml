<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AINovelWriter.Views.OutlinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AINovelWriter.Models"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Click="OnHome" Background="Transparent" BorderThickness="0" Padding="6">
                        <FontIcon Glyph="&#xE80F;" FontSize="16" />
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="大纲规划模式" FontSize="20" FontWeight="Bold" />
                        <TextBlock FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="{x:Bind Vm.Project.Title}" /><Run Text=" · 一句话创意 → AI 大纲 → 逐章确认 → 生成正文" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <ProgressRing IsActive="{x:Bind Vm.IsBusy, Mode=OneWay}" Width="18" Height="18" VerticalAlignment="Center" />
                    <Button Command="{x:Bind Vm.GoEditorCommand}" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                            <TextBlock Text="进入编辑器" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 创意输入 -->
        <Border Grid.Row="1" Padding="24,16,24,12">
            <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="10">
                <TextBlock Text="一句话创意" FontWeight="SemiBold" />
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{x:Bind Vm.IdeaInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="例如：一个被逐出师门的少年剑客，在万妖山脉获得上古传承，追寻剑道极致并揭开身世之谜。" />
                    <Button Grid.Column="1" Command="{x:Bind Vm.GenerateOutlineCommand}" Style="{StaticResource AccentButtonStyle}" MinWidth="130">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE945;" FontSize="14" />
                            <TextBlock Text="AI 生成大纲" />
                        </StackPanel>
                    </Button>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 大纲树 -->
        <ScrollViewer Grid.Row="2" Padding="24,0,24,16">
            <ItemsControl ItemsSource="{x:Bind Vm.Outlines}" MaxWidth="1000" HorizontalAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:OutlineNode">
                        <StackPanel Margin="0,0,0,18">
                            <!-- 卷 -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12,12,0,0"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16,12">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border CornerRadius="6" Padding="7,2" Background="#EEE7FE">
                                            <TextBlock Text="{x:Bind LevelLabel}" FontSize="11" Foreground="#7C3AED" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Summary, Mode=OneWay}" FontSize="12.5" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <!-- 章列表 -->
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="0,0,12,12"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,1,1" Padding="10">
                                <ItemsControl ItemsSource="{x:Bind Children}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:OutlineNode">
                                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Spacing="3">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                                            <Border CornerRadius="5" Padding="6,1" Background="#E6F7F0" VerticalAlignment="Center"
                                                                    Visibility="{x:Bind HasContent, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                                <TextBlock Text="已生成正文" FontSize="10" Foreground="#10A37A" />
                                                            </Border>
                                                            <Border CornerRadius="5" Padding="6,1" Background="#E7F0FE" VerticalAlignment="Center"
                                                                    Visibility="{x:Bind IsConfirmed, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                                <TextBlock Text="已确认" FontSize="10" Foreground="#2E7DF6" />
                                                            </Border>
                                                        </StackPanel>
                                                            <TextBlock Text="{x:Bind Summary, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                   Visibility="{x:Bind KeyCharacters, Mode=OneWay, Converter={StaticResource StringToVisibility}}">
                                                            <Run Text="关键人物：" /><Run Text="{x:Bind KeyCharacters, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                                                        <Button Click="OnEditNode" Padding="8,4" ToolTipService.ToolTip="编辑该节点">
                                                            <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                                        </Button>
                                                        <Button Click="OnToggleConfirm" Padding="8,4" BorderThickness="1"
                                                                Background="{x:Bind IsConfirmed, Mode=OneWay, Converter={StaticResource ConfirmBrush}}"
                                                                ToolTipService.ToolTip="确认 / 取消确认">
                                                            <TextBlock Text="{x:Bind IsConfirmed, Mode=OneWay, Converter={StaticResource ConfirmText}}" FontSize="12" />
                                                        </Button>
                                                        <Button Click="OnGenerateBody" Padding="8,4"
                                                                IsEnabled="{x:Bind IsConfirmed, Mode=OneWay}"
                                                                ToolTipService.ToolTip="请先确认该章大纲">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <FontIcon Glyph="&#xE945;" FontSize="12" Foreground="#7C3AED" />
                                                                <TextBlock Text="生成正文" FontSize="12" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Click="OnOpenInEditor" Padding="8,4" ToolTipService.ToolTip="在编辑器中打开"
                                                                Visibility="{x:Bind HasContent, Converter={StaticResource BoolToVisibility}}">
                                                            <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 底部进度 -->
        <Border Grid.Row="3" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,10"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                <Run Text="已确认 " /><Run Text="{x:Bind Vm.ConfirmedCount, Mode=OneWay}" /><Run Text=" / " /><Run Text="{x:Bind Vm.ChapterCount, Mode=OneWay}" /><Run Text=" 章" />
            </TextBlock>
        </Border>

        <!-- 节点编辑对话框 -->
        <ContentDialog x:Name="NodeDialog" Grid.RowSpan="4" Title="编辑节点" PrimaryButtonText="保存" CloseButtonText="取消"
                       PrimaryButtonClick="OnNodeDialogSave">
            <StackPanel Spacing="10" Width="460">
                <TextBox x:Name="NodeTitle" Header="标题" />
                <TextBox x:Name="NodeSummary" Header="剧情概要" Height="90" AcceptsReturn="True" TextWrapping="Wrap" />
                <TextBox x:Name="NodeKey" Header="关键人物" PlaceholderText="逗号分隔，如：林逸、苏婉清" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
