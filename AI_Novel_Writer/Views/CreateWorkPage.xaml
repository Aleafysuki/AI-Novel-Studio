<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AINovelWriter.Views.CreateWorkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Padding="28,20,28,12">
            <Button Click="OnBack" Padding="8" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="创建新作品" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="填写基础信息，AI 将据此为你的作品建立创作上下文" FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- 表单 -->
        <ScrollViewer Grid.Row="1" Padding="28,8,28,8">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="22">

                <!-- 作品名称 -->
                <StackPanel Spacing="6">
                    <TextBlock Text="作品名称 *" FontWeight="SemiBold" />
                    <TextBox x:Name="TitleBox" PlaceholderText="例如：剑道独尊 · 外传"
                             Text="{x:Bind Vm.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!-- 类型 + 平台 -->
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="小说类型" FontWeight="SemiBold" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind Vm.GenreOptions}"
                                  SelectedItem="{x:Bind Vm.Genre, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="目标平台" FontWeight="SemiBold" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind Vm.PlatformOptions}"
                                  SelectedItem="{x:Bind Vm.TargetPlatform, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>

                <!-- 原创 / 同人 -->
                <StackPanel Spacing="8">
                    <TextBlock Text="创作模式" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <RadioButton Content="原创" GroupName="mode" IsChecked="{x:Bind Vm.IsFanFiction, Mode=TwoWay, Converter={StaticResource InvertBool}}" />
                        <RadioButton Content="同人" GroupName="mode" IsChecked="{x:Bind Vm.IsFanFiction, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBox PlaceholderText="原作名称（同人作品需填写，如：剑道独尊）"
                             Visibility="{x:Bind Vm.IsFanFiction, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                             Text="{x:Bind Vm.OriginalWork, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!-- 世界观 -->
                <StackPanel Spacing="6">
                    <TextBlock Text="世界观 / 简介" FontWeight="SemiBold" />
                    <TextBox Height="110" TextWrapping="Wrap" AcceptsReturn="True"
                             PlaceholderText="用几句话描述你的世界观、核心设定或故事梗概。AI 会将其作为锁定设定，生成时严格遵守。"
                             Text="{x:Bind Vm.Worldview, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!-- AI 风格 -->
                <StackPanel Spacing="6">
                    <TextBlock Text="AI 创作风格" FontWeight="SemiBold" />
                    <ComboBox HorizontalAlignment="Stretch" MaxWidth="360"
                              ItemsSource="{x:Bind Vm.StyleOptions}"
                              SelectedItem="{x:Bind Vm.AiStyle, Mode=TwoWay}" />
                </StackPanel>

                <!-- AI 参与度 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="20">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="初始 AI 参与度" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border CornerRadius="10" Padding="10,2"
                                    Background="{x:Bind Vm.Participation, Mode=OneWay, Converter={StaticResource ParticipationColor}}">
                                <TextBlock Text="{x:Bind Vm.ParticipationMode, Mode=OneWay}" Foreground="White" FontSize="12.5" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="{x:Bind Vm.Participation, Mode=OneWay}" /><Run Text="%" />
                            </TextBlock>
                        </StackPanel>
                        <Slider Minimum="0" Maximum="100" StepFrequency="1" TickFrequency="25" TickPlacement="Outside"
                                Value="{x:Bind Vm.Participation, Mode=TwoWay}" />
                        <TextBlock Text="{x:Bind Vm.ParticipationDesc, Mode=OneWay}" TextWrapping="Wrap" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底栏 -->
        <Border Grid.Row="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                <Button Content="取消" Click="OnBack" MinWidth="90" />
                <Button Content="创建并规划大纲" Click="OnCreateAndOutline" MinWidth="130"
                        IsEnabled="{x:Bind Vm.CanCreate, Mode=OneWay}" />
                <Button Content="创建并进入编辑器" Click="OnCreateAndEdit" MinWidth="150"
                        Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{x:Bind Vm.CanCreate, Mode=OneWay}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
