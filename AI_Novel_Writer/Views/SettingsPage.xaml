<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AINovelWriter.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AINovelWriter.Models"
    xmlns:svc="using:AINovelWriter.Services"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Padding="28,20,28,12">
            <Button Click="OnBack" Padding="8" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="应用设置" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="配置 AI 接口、自定义写作风格与每个命令的 Prompt 模板" FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="28,8,28,24">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left" Spacing="22">

                <!-- AI 接口 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="20">
                    <StackPanel Spacing="14">
                        <TextBlock Text="AI 接口配置" FontWeight="SemiBold" FontSize="15" />
                        <StackPanel Spacing="6">
                            <TextBlock Text="提供方" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox HorizontalAlignment="Stretch" MinWidth="320"
                                      ItemsSource="{x:Bind svc:AppState.Settings.ApiProviders}"
                                      SelectedItem="{x:Bind svc:AppState.Settings.ApiProvider, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="API Key" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <PasswordBox x:Name="ApiKeyBox" HorizontalAlignment="Stretch" MinWidth="320" PlaceholderText="本地模拟模式无需填写" />
                        </StackPanel>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="Base URL" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox HorizontalAlignment="Stretch" Text="{x:Bind svc:AppState.Settings.ApiBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="https://..." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="模型名" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox HorizontalAlignment="Stretch" Text="{x:Bind svc:AppState.Settings.ApiModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="gpt-4o / deepseek-chat" />
                            </StackPanel>
                        </Grid>
                        <TextBlock FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Text="提示：当前为原型，AI 生成为本地模拟。配置仅作保存，接入真实接口时即可生效。" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 自定义写作风格 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="自定义写作风格" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="添加的自定义风格会出现在创建作品与编辑器 Prompt 的风格下拉中。" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{x:Bind svc:AppState.Settings.CustomStyles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid ColumnSpacing="8" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="删除" Click="OnRemoveStyle" Padding="10,4" FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid ColumnSpacing="8" MaxWidth="420">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="NewStyleBox" PlaceholderText="输入新风格，如：克苏鲁 / 蒸汽朋克" />
                            <Button Grid.Column="1" Content="添加" Click="OnAddStyle" Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 命令 Prompt 模板 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="各命令的 Prompt 模板" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="为续写 / 重写 / 扩写 / 缩写等每个命令定制提示词；执行命令时还会叠加你在编辑器中填写的「修改意见」。" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{x:Bind svc:AppState.Settings.PromptTemplates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:PromptTemplateItem">
                                    <Grid ColumnSpacing="12" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="118" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind KindLabel}" VerticalAlignment="Top" Margin="0,10,0,0"
                                                   FontWeight="SemiBold" FontSize="13" />
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBox Text="{x:Bind Template, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" Height="58" />
                                            <Button Content="重置为默认" Click="OnResetTemplate" HorizontalAlignment="Right"
                                                    Padding="8,2" FontSize="11.5" Background="Transparent" BorderThickness="0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 外观主题 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="外观主题" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="选择浅色 / 深色，或跟随系统。保存后立即生效。" TextWrapping="Wrap" />
                        <ComboBox HorizontalAlignment="Left" MinWidth="220"
                                  ItemsSource="{x:Bind svc:AppState.Settings.ThemeOptions}"
                                  SelectedItem="{x:Bind svc:AppState.Settings.Theme, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- 用户预设（自定义写作风格 / 设定） -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="用户预设（自定义写作风格 / 设定）" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="为某个写作风格填写详细说明，AI 生成时会自动套用为上下文；预设名称会出现在风格下拉中，与内置风格合并使用。" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{x:Bind svc:AppState.Settings.UserPresets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:UserPreset">
                                    <Border Background="{ThemeResource LayerFillColorAltBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Header="预设名称（即风格名）"
                                                         Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         PlaceholderText="如：赛博朋克废土" />
                                                <Button Grid.Column="1" Content="删除" Click="OnRemovePreset"
                                                        VerticalAlignment="Bottom" Padding="10,6" FontSize="12" />
                                            </Grid>
                                            <TextBox Header="预设内容（AI 生成时套用的说明）"
                                                     Text="{x:Bind Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" Height="96"
                                                     PlaceholderText="描述该风格的语气、用词、世界观基调、禁忌等…" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid ColumnSpacing="8" MaxWidth="560">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="NewPresetName" PlaceholderText="预设名称" />
                            <TextBox Grid.Column="1" x:Name="NewPresetContent" PlaceholderText="预设内容（可选）"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="56" />
                            <Button Grid.Column="2" Content="添加预设" Click="OnAddPreset"
                                    Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Button Content="保存设置" Click="OnSave" Style="{StaticResource AccentButtonStyle}" MinWidth="140" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
