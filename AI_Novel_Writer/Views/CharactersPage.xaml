<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AINovelWriter.Views.CharactersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AINovelWriter.Models"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <Button x:Name="BackButton" Click="OnBack" Background="Transparent" BorderThickness="0" Padding="6"
                            ToolTipService.ToolTip="返回编辑器">
                        <FontIcon Glyph="&#xE80F;" FontSize="16" />
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="人物表格" FontWeight="Bold" FontSize="18" />
                        <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddButton" Click="OnAddCharacter">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="新增人物" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeleteSelectedButton" Click="OnDeleteSelected" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            <TextBlock Text="删除选中" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 人物表格 -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
            <StackPanel Padding="16,12" Spacing="12">
                <!-- 表格标题 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="0"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Padding" Value="0,8" />
                                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Style>
                        </Grid.Resources>

                        <CheckBox Grid.Column="0" x:Name="SelectAllCheck" HorizontalAlignment="Center"
                                  Checked="OnSelectAll" Unchecked="OnUnselectAll" />
                        <TextBlock Grid.Column="1" Text="姓名" />
                        <TextBlock Grid.Column="2" Text="身份" />
                        <TextBlock Grid.Column="3" Text="别名" />
                        <TextBlock Grid.Column="4" Text="性格标签" />
                        <TextBlock Grid.Column="5" Text="角色设定" />
                        <TextBlock Grid.Column="6" Text="操作" HorizontalTextAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 表格行 -->
                <ItemsControl x:Name="CharacterItems" ItemsSource="{x:Bind Characters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:Character">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Padding="0"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" HorizontalAlignment="Center" Tag="{x:Bind Id}" />
                                    <TextBox Grid.Column="1" Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" Margin="2" />
                                    <TextBox Grid.Column="2" Text="{x:Bind Role, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" Margin="2" />
                                    <TextBox Grid.Column="3" Text="{x:Bind Alias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" Margin="2" />
                                    <TextBox Grid.Column="4" Text="{x:Bind PersonalityTags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" Margin="2" />
                                    <TextBox Grid.Column="5" Text="{x:Bind Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" Margin="2" MaxLength="200" />
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                        <Button Click="OnEditCharacterDetailed" Padding="4" Background="Transparent" BorderThickness="0"
                                                ToolTipService.ToolTip="详细编辑">
                                            <FontIcon Glyph="&#xE70F;" FontSize="13" />
                                        </Button>
                                        <Button Click="OnDeleteCharacterRow" Padding="4" Background="Transparent" BorderThickness="0"
                                                ToolTipService.ToolTip="删除" Foreground="#E02E3B">
                                            <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- 状态栏 -->
        <Border Grid.Row="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,6"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Border>
    </Grid>
</Page>
