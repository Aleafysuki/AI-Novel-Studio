<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AINovelWriter</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <!-- 统一默认目标平台为 x64，避免 dotnet build 默认 AnyCPU 与 IDE 的 x64 产生两套 obj 导致 .g.cs 重复定义(CS0229/CS0121) -->
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <!--
      WinUISDKReferences 必须为 false（显式关闭 WinUI SDK 自动引用）；
      项目已显式引用 Microsoft.WindowsAppSDK 与 Microsoft.Windows.SDK.BuildTools.WinApp，
      开启此选项会导致 XAML 编译器在干净构建时与手动引用冲突而崩溃（WMC9999 NullReference）。
      EnableMsixTooling 已关闭，故不会触发 DEP1700。
    -->
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>false</EnableMsixTooling>
    <!--
      Publish 兜底属性：当没有 pubxml 或发布时未显式指定时的默认值。
      - WindowsPackageType=None        → Unpackaged 发布（独立 exe，不打包 MSIX）
      - WindowsAppSDKSelfContained=true → 将 WinAppSDK 运行时 DLL 拷贝到 exe 同目录
      - SelfContained=true             → 自包含发布（捆绑 .NET 运行时）
      使用 Condition 判断确保 pubxml 中的显式设置能覆盖这些默认值。
    -->
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(WindowsAppSDKSelfContained)' == ''">true</WindowsAppSDKSelfContained>
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 禁用 WinUI 自动生成的 Program.Main，改由下方 Program.cs 显式入口（先 Bootstrap.Initialize 再启动 App），修复 .NET 10 下 self-host 自动初始化失效 -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!--
    MSIX 打包所需的包身份信息。仅在 MSIX 发布(WindowsPackageType=MSIX)时生效，
    对独立 exe 发布无影响。
    签名使用本地自签名证书 AINovelWriter_TemporaryKey.pfx（CN=AINovelWriter，含 AppX 打包 EKU）。
    侧载安装前需先将同名 .cer 安装到"受信任的根证书颁发机构"（见交付说明）。
  -->
  <PropertyGroup>
    <PackageId>AINovelWriter</PackageId>
    <Publisher>CN=AINovelWriter</Publisher>
    <PackageDisplayName>AI Novel Writer</PackageDisplayName>
    <PublisherDisplayName>AI Novel Writer</PublisherDisplayName>
    <ApplicationId>App</ApplicationId>
    <ApplicationDisplayName>AI Novel Writer</ApplicationDisplayName>
    <PackageVersion>1.0.0.0</PackageVersion>
    <PackageCertificateKeyFile>AINovelWriter_TemporaryKey.pfx</PackageCertificateKeyFile>
    <!--
      证书密码不写入源码（安全要求）。
      如需 MSIX 签名，请自行生成自签名证书并放置 AINovelWriter_TemporaryKey.pfx，
      密码通过环境变量或命令行传入：dotnet publish -p:PackageCertificatePassword=你的密码
    -->
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Bootstrap.Net 由 Microsoft.WindowsAppSDK NuGet 包的传递依赖自动处理。
    Microsoft.WindowsAppSDK.Foundation 包在构建时会自动生成 Bootstrap.Net.dll 的引用，
    因此不再需要手动硬编码 HintPath。移除后统一版本解析，避免跨版本不兼容。
    （详见 deps.json 中的 Microsoft.WindowsAppSDK.Foundation/2.3.5 条目）
  -->
  <!-- Bootstrap.Net.dll 引用已移至 NuGet 包自动管理 -->

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.4.0" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!--
    Publish 设置：
    - PublishTrimmed 关闭：WinUI 3 大量使用反射 / XAML 投影 / COM 互操作，
      裁剪(trim)极易误删必要类型导致运行时崩溃；本原型追求"能跑"，故关闭。
    - PublishReadyToRun 关闭：避免 R2R 编译在非常规目标机上出现的兼容/启动问题，
      用体积换稳妥。
    - CsWinRTUseWindowsUIXamlProjections true：启用 CsWinRT XAML 投影，
      确保 XAML 类型系统在 .NET 10 + WinUI 3 下正确初始化。
  -->
  <PropertyGroup>
    <PublishReadyToRun>False</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
    <CsWinRTUseWindowsUIXamlProjections>true</CsWinRTUseWindowsUIXamlProjections>
  </PropertyGroup>
</Project>
